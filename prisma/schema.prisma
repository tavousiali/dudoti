generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Page {
  Id       Int     @id @default(autoincrement())
  Title    String?
  Text     String?
  seen     Int?    @default(0)
  Type     Int?    @default(1)
  Lang     Int
  Pic      String?
  Lead     String?
  urlTitle String?
  Priority Int?    @default(0)
  PreTitle String?
  SubTitle String?
  SeoLead  String?
  SeoTitle String?
}

model Social {
  Id             Int     @id @default(autoincrement())
  Icon           String?
  Link           String?
  Lang           Int
  Title          String?
  FooterOrHeader Int?    @default(1)
  Priority       Int?    @default(1)
}

model MainPage {
  Id            Int     @id @default(autoincrement())
  Footer        String?
  CR            String?
  MainTitle     String?
  Keywords      String?
  Description   String?
  GArz          Int?    @default(0)
  GTool         Int?    @default(0)
  MapActive     Int?    @default(0)
  ShortTitle    String?
  Tel           String?
  Lang          Int
  DefaultLang   Int?    @default(1)
  ContactText   String?
  Slogan        String?
  ProductsCount Int?    @default(0)
  EmailAddress  String?
  SloganTitle   String?
  SloganImage   String?
  SiteMain      String?
  LangUrl       String?
  LangUrlLink   String?
}

model Product {
  Id              Int     @id @default(autoincrement())
  Title           String?
  Pic1            String?
  Pic2            String?
  Av              Int?
  CatId           Int?
  CatName         String?
  Lang            Int?
  Deleted         Boolean @default(false)
  IsNew           Boolean @default(false)
  MainId          Int?
  urlTitle        String?
  Date            String?
  Video           String?
  VideoPic        String?
  Pdf             String?
  Priority        Int?    @default(0)
  Code            String?
  urlTitlteCat    String?
  SEOTitle        String?
  OldLink2        String?
  OldLink         String?
  CurrentPrice    Float?
  CurrentOffPrice Float?
  Weight          Float?
  TitleEn         String?
  MainName        String?
  MainUrlTitle    String?
  SubTitle        String?
  Title2          String?
  Icon            String?
  ListImageMain   String?
  ListImageOver   String?
  OverClass       String?
  SeoLead         String?
  Description     String?
  Lead            String?
  Description2    String?
}

model ProductCategory {
  Id          Int     @id @default(autoincrement())
  Title       String
  Pic1        String?
  Pic2        String?
  Lang        Int
  Priority    Int     @default(0)
  Lead        String?
  Description String?
  Deleted     Boolean @default(false)
  ShowMenu    Boolean @default(false)
  Actice      Boolean @default(true)
  urlTitle    String?
  ParentId    Int     @default(0)
  ParentName  String?
  TitleEn     String?
  SeoTitle    String?
  SeoLead     String?
  CSSClass    String?
  Video       String?
  VideoPic    String?
}

model Character {
  Id       Int     @id @default(autoincrement())
  Lang     Int
  Name     String
  Desc     String?
  Img1     String?
  Img2     String?
  BgColor  String?
  CSSClass String?
  Priority Int     @default(0)
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  name       String
  email      String?
  active     Boolean   @default(true)
  lastLogFa  String?
  lastLog    DateTime?
  semat      String?
  type       Int       @default(1)
  pic        String?
  branchId   Int?
  branchName String?
  hashedId   String?
  hashCode   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Size {
  Id    Int     @id
  Title String?
  Arz   Int?
  Tool  Int?
  TArz  Int?
  TTool Int?
}

model Word {
  Id       Int    @id
  Lang     Int
  Title    String
  PageName String
}

model AdminMenu {
  MenuId       Int     @id
  MenuName     String?
  ParentMenuId Int?
  Icon         String?
  Address      String?
  Priority     Int?
  JustMaze     Boolean?
  Icon2        String?
}

model WorkgroupAccess {
  wgId            Int     @id
  WorkgroupName   String?
  MenuAccess      String?
  CanDelete       Boolean?
  CanDelP         Boolean?
  CanDelE         Boolean?
  CanEditP        Boolean?
  CanEditE        Boolean?
  CanAddE         Boolean?
  CanEditMem      Boolean?
  CanSeeDashBoard Boolean?
  CanSearch       Boolean?
  DepentTime      Boolean?
  CanAddCredit    Boolean?
}
