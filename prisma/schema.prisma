// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ProductCategory {
  Id          Int     @id
  Title       String
  Pic1        String?
  Pic2        String?
  Lang        Int
  Priority    Int     @default(0)
  Lead        String?
  Description String?
  Deleted     Boolean @default(false)
  ShowMenu    Boolean @default(false)
  Actice      Boolean @default(true)
  urlTitle    String?
  ParentId    Int     @default(0)
  ParentName  String?
  TitleEn     String?
  SeoTitle    String?
  SeoLead     String?
  CSSClass    String?
  Video       String?
  VideoPic    String?
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  name       String
  email      String?
  active     Boolean  @default(true)
  lastLogFa  String?
  lastLog    DateTime?
  semat      String?
  type       Int      @default(1)
  pic        String?
  branchId   Int?
  branchName String?
  hashedId   String?
  hashCode   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
